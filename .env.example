# Copy to .env.local (gitignored) and fill in. `npm run db:provision` writes
# all of these for you given a SUPABASE_ACCESS_TOKEN; this file is the manual
# route, and the record of what the scripts actually read.
#
# Nothing here is needed to run the prototype. prototype/ctv-os.html is
# self-contained and persists to localStorage — there is no client yet.

# Personal access token from https://supabase.com/dashboard/account/tokens
# Needed only by `npm run db:provision`. Never commit it.
SUPABASE_ACCESS_TOKEN=sbp_...

# Written by provisioning. Used by `npm run verify:remote`, which skips its
# REST checks unless both URL and key are set.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...

# Direct Postgres connection. `npm run verify:remote` runs its assertions
# inside a transaction and rolls back, so it is safe against a live project.
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
